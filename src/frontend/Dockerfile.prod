# Production frontend image (Phase M9): builds the Next.js app at image-build
# time and serves it with `next start`. No source bind-mount and no HMR — the
# build is baked into the image and only rebuilt on `docker compose build`.
FROM node:22-alpine

WORKDIR /app

# NEXT_TELEMETRY_DISABLED only — do NOT set NODE_ENV=production here, or `npm ci`
# would skip the devDependencies (typescript, tailwind) that `next build` needs.
# `next build` emits a production build regardless, and `next start` sets
# NODE_ENV=production itself at runtime.
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
