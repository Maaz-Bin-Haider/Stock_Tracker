# macOS
.DS_Store

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Dependencies and build outputs
node_modules/
dist/
build/
.next/
.nuxt/
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local generated files
data/exports/*
!data/exports/.gitkeep

# Local database backups (Phase M9 offline stack)
data/backups/*
!data/backups/.gitkeep


# Python tooling caches
.pytest_cache/
.ruff_cache/

# Django dev files
src/backend/media/*
!src/backend/media/.gitkeep
src/backend/staticfiles/
# Generated report exports (private, served only via the authenticated API)
src/backend/exports/

# TypeScript
*.tsbuildinfo

# Python build artifacts
*.egg-info/
