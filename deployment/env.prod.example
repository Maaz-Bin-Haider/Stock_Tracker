# Offline / local production config (Phase M9).
# Copy this file to deployment/.env.prod and fill in the values, then run `make prod-up`.
# deployment/.env.prod is gitignored — never commit real secrets.

# --- Django ---
# Generate a fresh key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_generate_a_50_char_random_key

# Every hostname/IP users will reach the server by (comma-separated, no scheme).
# Keep localhost,127.0.0.1,backend and ADD the machine's LAN IP and/or hostname.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.1.50

# The exact browser origin(s), WITH scheme and port (comma-separated).
# Must match how users open the app, e.g. http://192.168.1.50:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.50:8080

# Leave 0 for plain HTTP on a trusted LAN. Set to 1 ONLY if you terminate TLS in
# front of nginx — otherwise secure cookies stop flowing and login breaks.
DJANGO_SECURE_COOKIES=0

# --- Database (internal to the stack; not exposed to the LAN) ---
POSTGRES_DB=stock_tracker
POSTGRES_USER=stock_tracker
POSTGRES_PASSWORD=CHANGE_ME_choose_a_strong_db_password

# --- Networking ---
# Host port the site is served on. 8080 by default; set to 80 for http://<ip>/ .
HTTP_PORT=8080

# --- Backups (backup sidecar -> ./data/backups) ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
