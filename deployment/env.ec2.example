# AWS EC2 production configuration. Generate the real gitignored file with:
#   scripts/generate-ec2-env.sh ELASTIC_IP ADMIN_EMAIL

ELASTIC_IP=203.0.113.10
LETSENCRYPT_EMAIL=admin@example.com
NGINX_CONFIG_FILE=ec2-bootstrap.conf

DJANGO_SECRET_KEY=CHANGE_ME_generated_random_value
DJANGO_ALLOWED_HOSTS=203.0.113.10,localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://203.0.113.10

POSTGRES_DB=stock_tracker
POSTGRES_USER=stock_tracker
POSTGRES_PASSWORD=CHANGE_ME_generated_random_value

# Matched database/media pairs remain on EC2 for now. Future phase: copy them
# automatically to a private encrypted S3 bucket for off-instance recovery.
HOST_UID=1000
HOST_GID=1000
BACKUP_INTERVAL_SECONDS=43200
BACKUP_RETENTION_DAYS=120
